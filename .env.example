# Copy to .env.local (ignored by Git) and fill in. Every key is optional;
# without one the dashboard runs with clearly labeled fallbacks.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
NY511_API_KEY=""
NY511_REFRESH_S="600"
